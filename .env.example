# Test environment only. This build deliberately refuses production mode.
MESH_MODE=sandbox
PLAID_ENV=sandbox
MESH_BIND=127.0.0.1:8787
MESH_DATABASE=.local/mesh.sqlite

# Optional: real Plaid Sandbox bank linking. Leave all three unset for demo banking.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_REDIRECT_URI=https://YOUR-DOMAIN/plaid/

# Dwolla Sandbox app integration or separate administrative acceptance runner.
# DWOLLA_ENV=sandbox
# DWOLLA_KEY=
# DWOLLA_SECRET=
# For the separate acceptance runner only, set both of these:
# MESH_BANK_OUTBOX=.local/banking.sqlite
# DWOLLA_WEBHOOK_SECRET=

# Optional: 32 random bytes encoded as 64 lowercase hex characters.
# Otherwise a 0600 vault-key file is created beside the database. Preserve it.
# MESH_VAULT_KEY=

# Bank-backed Sandbox app: use a NEW database; demo balances cannot change rails.
# MESH_RAIL=dwolla_sandbox
# MESH_DATABASE=.local/dwolla-wallet.sqlite
# Requires all Plaid and Dwolla settings above. The server polls without webhooks.
# If DWOLLA_WEBHOOK_SECRET is set, webhooks automatically use MESH_DATABASE.
# MESH_BANK_OUTBOX must be omitted or exactly equal to MESH_DATABASE in this mode.
