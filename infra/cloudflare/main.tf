terraform {
  required_version = "= 1.13.2"
  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "= 5.28.1"
    }
  }
  backend "s3" {}
}

# Credentials come from CLOUDFLARE_API_TOKEN, never a Terraform variable.
provider "cloudflare" {}

variable "apple_app_id" {
  description = "Actual Apple application identifier: TEAMID.bundle.identifier, matching the generated AASA."
  type        = string
  validation {
    condition     = can(regex("^[A-Z0-9]{10}\\.[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$", var.apple_app_id))
    error_message = "Use your actual 10-character Apple team ID followed by the bundle identifier."
  }
}

variable "aasa_file" {
  description = "Path to apple-app-site-association generated by scripts/configure-banking.py. Relative paths are resolved from this Terraform directory."
  type        = string
  default     = "../../.local/banking/apple-app-site-association"
}

locals {
  account_id              = "5e14675da5483007be95a181da33f02b"
  aasa                    = jsondecode(file(var.aasa_file))
  generated_configuration = jsondecode(file("${dirname(var.aasa_file)}/configuration.json"))
  expected_aasa = {
    applinks = { details = [{ appIDs = [var.apple_app_id], components = [{ "/" = "/plaid/" }] }] }
  }
}

resource "cloudflare_workers_script" "oauth" {
  account_id         = local.account_id
  script_name        = "payment-mesh"
  compatibility_date = "2026-11-02"
  main_module        = "worker.mjs"
  content            = file("${path.module}/worker.mjs")
  bindings = [{
    name = "AASA_JSON"
    type = "plain_text"
    text = jsonencode(local.aasa)
  }]
  observability = {
    enabled             = true
    redact_query_string = true
    logs = {
      enabled         = true
      invocation_logs = false
    }
    traces = {
      enabled = true
    }
  }
  lifecycle {
    precondition {
      condition     = jsonencode(local.aasa) == jsonencode(local.expected_aasa)
      error_message = "Generate AASA for the configured Apple app ID and https://payment-mesh.dylanmitic.workers.dev/plaid/."
    }
    precondition {
      condition = try(
        local.generated_configuration.redirect_uri == "https://payment-mesh.dylanmitic.workers.dev/plaid/" &&
        "${local.generated_configuration.team_id}.${local.generated_configuration.bundle_id}" == var.apple_app_id,
        false
      )
      error_message = "The adjacent generated configuration.json must match this Worker's exact OAuth redirect and Apple app ID. Regenerate the iOS configuration for this hostname."
    }
  }
}

resource "cloudflare_workers_script_subdomain" "oauth" {
  account_id       = local.account_id
  script_name      = cloudflare_workers_script.oauth.script_name
  enabled          = true
  previews_enabled = false
}

output "plaid_redirect_uri" {
  value = "https://payment-mesh.dylanmitic.workers.dev/plaid/"
}

output "aasa_url" {
  value = "https://payment-mesh.dylanmitic.workers.dev/.well-known/apple-app-site-association"
}
